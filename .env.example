# Lead Generation Bot Configuration
# Copy this file to .env and fill in your values

# Search Query - what restaurants to look for
LEAD_GEN_QUERY=family restaurant maryland

# API Keys (you need at least one)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# Optional: SearXNG URL for website lookup (self-hosted search)
# SEARXNG_URL=http://localhost:8080
