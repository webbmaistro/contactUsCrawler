# Lead Gen API Keys and Configuration
# Copy this file to .env and fill in your actual values

# Geoapify API Key (get from https://myprojects.geoapify.com/)
GEOAPIFY_API_KEY=your_geoapify_key_here

# Google Places API Key (optional, get from https://console.cloud.google.com/)
# GOOGLE_PLACES_API_KEY=your_google_key_here

# Search query for lead generation
LEAD_GEN_QUERY=restaurants in Denver Colorado

# Ollama chain filter (1 to enable, 0 to disable)
# LEAD_GEN_USE_OLLAMA_CHAIN=1

# SearXNG URL (optional, for free website lookups)
# SEARXNG_URL=http://localhost:8080
